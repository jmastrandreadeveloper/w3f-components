    {
      "title": "Con tamaño predefinido",
      "code": "<Icon name=\"Heart\" size=\"lg\" color=\"red\" />"
    },
    {
      "title": "Botón con icono",
      "code": "<IconButton name=\"Download\" label=\"Descargar\" variant=\"primary\" onClick={handleClick} />"
    },
